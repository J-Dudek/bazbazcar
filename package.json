{
  "name": "bazbazcar-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:netlify": "node scripts/generate-environment.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:rgaa": "eslint --config eslint.rgaa.config.js \"src/**/*.html\"",
    "lint:watch": "chokidar \"src/**/*.{ts,html}\" -c \"npm run lint\" --initial",
    "dev": "concurrently -n ng,lint -c \"blue,yellow\" \"npm:start\" \"npm:lint:watch\"",
    "setup": "node setup-local.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:functions": "supabase functions serve",
    "supabase:types": "supabase gen types typescript --local > src/app/shared/models/database.types.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "design-j6n": "^0.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.5.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "supabase": "^2.117.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.0.8"
  }
}
